# Xorix Server Edition - Multi-Architecture Build System
# Supports x86, x86_64, and ARM architectures

# Default architecture
ARCH ?= x86

# Architecture-specific settings
ifeq ($(ARCH),x86)
    CC = i686-elf-gcc
    CXX = i686-elf-g++
    AS = i686-elf-as
    LD = i686-elf-ld
    OBJCOPY = i686-elf-objcopy
    CFLAGS = -m32 -fno-use-cxa-atexit -nostdlib -fno-builtin -fno-rtti -fno-exceptions -fno-leading-underscore
    ASFLAGS = --32
    LDFLAGS = -melf_i386
    ARCH_DIR = arch/x86
    KERNEL_NAME = xorix-x86.bin
    ISO_NAME = xorix-x86.iso
endif

ifeq ($(ARCH),x86_64)
    CC = x86_64-elf-gcc
    CXX = x86_64-elf-g++
    AS = x86_64-elf-as
    LD = x86_64-elf-ld
    OBJCOPY = x86_64-elf-objcopy
    CFLAGS = -m64 -fno-use-cxa-atexit -nostdlib -fno-builtin -fno-rtti -fno-exceptions -fno-leading-underscore
    ASFLAGS = --64
    LDFLAGS = -melf_x86_64
    ARCH_DIR = arch/x86_64
    KERNEL_NAME = xorix-x86_64.bin
    ISO_NAME = xorix-x86_64.iso
endif

ifeq ($(ARCH),arm)
    CC = arm-none-eabi-gcc
    CXX = arm-none-eabi-g++
    AS = arm-none-eabi-as
    LD = arm-none-eabi-ld
    OBJCOPY = arm-none-eabi-objcopy
    CFLAGS = -mcpu=cortex-a8 -fno-use-cxa-atexit -nostdlib -fno-builtin -fno-rtti -fno-exceptions
    ASFLAGS = -mcpu=cortex-a8
    LDFLAGS = -marmelf
    ARCH_DIR = arch/arm
    KERNEL_NAME = xorix-arm.bin
    ISO_NAME = xorix-arm.iso
endif

# Common flags
CFLAGS += -Iinclude -Iinstaller -Idrivers -Ishell -Ieditor -I$(ARCH_DIR)/include
CXXFLAGS = $(CFLAGS)

# Source directories
KERNEL_DIR = kernel
BOOT_DIR = boot
DRIVERS_DIR = drivers
FS_DIR = fs
SHELL_DIR = shell
EDITOR_DIR = editor
INSTALLER_DIR = installer

# Core kernel objects (minimal build)
CORE_OBJECTS = \
    $(KERNEL_DIR)/src/core/kernel.o \
    $(KERNEL_DIR)/src/core/memory.o \
    $(KERNEL_DIR)/src/core/gdt.o \
    $(KERNEL_DIR)/src/core/port.o

# Architecture-specific objects
ARCH_OBJECTS = \
    $(ARCH_DIR)/boot.o

# Driver objects (minimal build - exclude problematic drivers for now)
DRIVER_OBJECTS = 

# System components (minimal build - exclude problematic components for now)
SHELL_OBJECTS = 
EDITOR_OBJECTS = 
INSTALLER_OBJECTS = 

# All objects (minimal build)
ALL_OBJECTS = $(CORE_OBJECTS) $(ARCH_OBJECTS)

# Build targets
.PHONY: all clean install iso test help x86 x86_64 arm

all: $(KERNEL_NAME)

# Architecture-specific builds
x86:
	$(MAKE) ARCH=x86

x86_64:
	$(MAKE) ARCH=x86_64

arm:
	$(MAKE) ARCH=arm

# Main kernel build
$(KERNEL_NAME): $(ALL_OBJECTS)
	@echo "Linking $(KERNEL_NAME) for $(ARCH)..."
	$(LD) $(LDFLAGS) -T $(ARCH_DIR)/linker.ld -o $@ $(ALL_OBJECTS)
	@echo "Built $(KERNEL_NAME) successfully"

# Object file compilation rules
%.o: %.cpp
	@echo "Compiling $< for $(ARCH)..."
	$(CXX) $(CXXFLAGS) -c $< -o $@

%.o: %.c
	@echo "Compiling $< for $(ARCH)..."
	$(CC) $(CFLAGS) -c $< -o $@

%.o: %.s
	@echo "Assembling $< for $(ARCH)..."
	$(AS) $(ASFLAGS) -o $@ $<

# ISO creation
iso: $(ISO_NAME)

$(ISO_NAME): $(KERNEL_NAME)
	@echo "Creating ISO image $(ISO_NAME)..."
	mkdir -p iso/boot/grub
	cp $(KERNEL_NAME) iso/boot/
	cp $(ARCH_DIR)/grub.cfg iso/boot/grub/
	grub-mkrescue --output=$@ iso
	rm -rf iso
	@echo "ISO image $(ISO_NAME) created successfully"

# Installation
install: $(KERNEL_NAME)
	@echo "Installing $(KERNEL_NAME) to /boot..."
	sudo cp $(KERNEL_NAME) /boot/
	sudo update-grub
	@echo "Installation complete"

# Testing
test: $(ISO_NAME)
	@echo "Testing $(ISO_NAME) in QEMU..."
ifeq ($(ARCH),x86)
	qemu-system-i386 -cdrom $(ISO_NAME) -m 512M -serial stdio
endif
ifeq ($(ARCH),x86_64)
	qemu-system-x86_64 -cdrom $(ISO_NAME) -m 512M -serial stdio
endif
ifeq ($(ARCH),arm)
	qemu-system-arm -M versatilepb -kernel $(KERNEL_NAME) -m 512M -serial stdio
endif

# Cross-compilation toolchain setup
setup-toolchain:
	@echo "Setting up cross-compilation toolchain..."
	@echo "Please install the following packages:"
	@echo "For x86: i686-elf-gcc, i686-elf-binutils"
	@echo "For x86_64: x86_64-elf-gcc, x86_64-elf-binutils"
	@echo "For ARM: arm-none-eabi-gcc, arm-none-eabi-binutils"
	@echo ""
	@echo "Ubuntu/Debian: sudo apt install gcc-multilib"
	@echo "Or build from source using build-toolchain.sh"

# Clean
clean:
	@echo "Cleaning build files..."
	find . -name "*.o" -delete
	rm -f xorix-*.bin xorix-*.iso
	rm -rf iso
	@echo "Clean complete"

# Help
help:
	@echo "Xorix Server Edition - Multi-Architecture Build System"
	@echo ""
	@echo "Usage:"
	@echo "  make [ARCH=<arch>] [target]"
	@echo ""
	@echo "Architectures:"
	@echo "  x86      - 32-bit x86 (default)"
	@echo "  x86_64   - 64-bit x86_64"
	@echo "  arm      - ARM Cortex-A8"
	@echo ""
	@echo "Targets:"
	@echo "  all      - Build kernel for specified architecture"
	@echo "  x86      - Build for x86"
	@echo "  x86_64   - Build for x86_64"
	@echo "  arm      - Build for ARM"
	@echo "  iso      - Create bootable ISO image"
	@echo "  install  - Install kernel to /boot"
	@echo "  test     - Test in QEMU"
	@echo "  clean    - Clean build files"
	@echo "  setup-toolchain - Show toolchain setup instructions"
	@echo ""
	@echo "Examples:"
	@echo "  make                    # Build x86 kernel"
	@echo "  make ARCH=x86_64        # Build x86_64 kernel"
	@echo "  make arm iso            # Build ARM kernel and ISO"
	@echo "  make clean all          # Clean and rebuild"

# Build all architectures
all-arch:
	@echo "Building for all architectures..."
	$(MAKE) x86
	$(MAKE) x86_64
	$(MAKE) arm
	@echo "All architectures built successfully"

# Create release package
release: all-arch
	@echo "Creating release package..."
	mkdir -p release
	cp xorix-*.bin release/
	cp xorix-*.iso release/
	cp docs/* release/ 2>/dev/null || true
	tar -czf xorix-server-edition.tar.gz release/
	rm -rf release
	@echo "Release package created: xorix-server-edition.tar.gz"
