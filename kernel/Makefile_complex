# Xorix Kernel Makefile - Organized Structure
# Compiler and linker parameters
GPPPARAMS = -m32 -fno-use-cxa-atexit -nostdlib -fno-builtin -fno-rtti -fno-exceptions -fno-leading-underscore -Iinclude
ASPARAMS = --32
LDPARAMS = -melf_i386

# Source directories
CORE_DIR = src/core
DRIVERS_DIR = src/drivers
GUI_DIR = src/gui
MEMORY_DIR = src/memory
FS_DIR = src/filesystem
NETWORK_DIR = src/network
BUILD_DIR = build

# Core kernel objects
CORE_OBJECTS = $(BUILD_DIR)/loader.o $(BUILD_DIR)/gdt.o $(BUILD_DIR)/port.o \
               $(BUILD_DIR)/interruptstubs.o $(BUILD_DIR)/interrupts.o $(BUILD_DIR)/kernel.o

# Driver objects
KEYBOARD_OBJECTS = $(BUILD_DIR)/keyboard.o
MOUSE_OBJECTS = $(BUILD_DIR)/mouse.o
NETWORK_OBJECTS = $(BUILD_DIR)/network.o
STORAGE_OBJECTS = $(BUILD_DIR)/ata.o

# All driver objects
DRIVER_OBJECTS = $(KEYBOARD_OBJECTS) $(DRIVERS_SIMPLE_OBJECTS)

# All objects
OBJECTS = $(CORE_OBJECTS) $(DRIVER_OBJECTS)

# Default target
all: xorix.bin

# Create build directory
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Core kernel compilation rules
$(BUILD_DIR)/%.o: $(CORE_DIR)/%.cpp | $(BUILD_DIR)
	g++ $(GPPPARAMS) -o $@ -c $<

$(BUILD_DIR)/%.o: $(CORE_DIR)/%.s | $(BUILD_DIR)
	as $(ASPARAMS) -o $@ $<

# Driver compilation rules
$(BUILD_DIR)/keyboard.o: $(DRIVERS_DIR)/keyboard/keyboard.cpp | $(BUILD_DIR)
	g++ $(GPPPARAMS) -o $@ -c $<

$(BUILD_DIR)/mouse.o: $(DRIVERS_DIR)/mouse/mouse.cpp | $(BUILD_DIR)
	g++ $(GPPPARAMS) -o $@ -c $<

$(BUILD_DIR)/network.o: $(DRIVERS_DIR)/network/network.cpp | $(BUILD_DIR)

# Link kernel binary
xorix.bin: $(CORE_DIR)/linker.ld $(OBJECTS)
	ld $(LDPARAMS) -T $< -o $@ $(OBJECTS)

# Install to boot directory
install: xorix.bin
	sudo cp $< /boot/xorix.bin

# Create ISO image
xorix.iso: xorix.bin
	mkdir -p iso/boot/grub
	cp $< iso/boot/
	echo 'set timeout=0' > iso/boot/grub/grub.cfg 
	echo 'set default=0' >> iso/boot/grub/grub.cfg
	echo '' >> iso/boot/grub/grub.cfg
	echo 'menuentry "Xorix Operating System" {' >> iso/boot/grub/grub.cfg
	echo '	multiboot /boot/xorix.bin' >> iso/boot/grub/grub.cfg
	echo '	boot' >> iso/boot/grub/grub.cfg
	echo '}' >> iso/boot/grub/grub.cfg
	mkdir -p installation
	grub-mkrescue --output=./installation/$@ iso 
	rm -rf iso

# Debug target with symbols
debug: GPPPARAMS += -g -O0
debug: xorix.bin

# Release target with optimizations
release: GPPPARAMS += -O2
release: xorix.bin

# Test build (compile only, no link)
test-compile: $(OBJECTS)

# Show file structure
structure:
	@echo "Xorix Kernel File Structure:"
	@echo "├── src/"
	@echo "│   ├── core/          # Core kernel components"
	@echo "│   ├── drivers/       # Hardware drivers"
	@echo "│   │   ├── keyboard/  # Keyboard driver"
	@echo "│   │   ├── mouse/     # Mouse driver"
	@echo "│   │   ├── network/   # Network drivers"
	@echo "│   │   ├── storage/   # Storage drivers"
	@echo "│   │   ├── audio/     # Audio drivers"
	@echo "│   │   └── video/     # Video drivers"
	@echo "│   ├── gui/           # GUI framework"
	@echo "│   ├── memory/        # Memory management"
	@echo "│   ├── filesystem/    # File system"
	@echo "│   └── network/       # Network stack"
	@echo "├── include/           # Header files"
	@echo "├── build/             # Build artifacts"
	@echo "└── installation/      # ISO images"

# Clean build artifacts
clean:
	rm -rf $(BUILD_DIR)
	rm -rf installation
	rm -f xorix.bin

# Clean everything including generated files
distclean: clean
	rm -f *.o *.bin

# Help target
help:
	@echo "Xorix Kernel Build System"
	@echo "Available targets:"
	@echo "  all          - Build kernel binary (default)"
	@echo "  debug        - Build with debug symbols"
	@echo "  release      - Build with optimizations"
	@echo "  test-compile - Compile only, no linking"
	@echo "  install      - Install to /boot/"
	@echo "  xorix.iso    - Create bootable ISO"
	@echo "  structure    - Show file organization"
	@echo "  clean        - Remove build artifacts"
	@echo "  distclean    - Remove all generated files"
	@echo "  help         - Show this help"

.PHONY: all debug release test-compile install clean distclean help structure
